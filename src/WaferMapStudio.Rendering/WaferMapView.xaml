<!--
  可复用晶圆图渲染控件（不依赖任何 ViewModel）：
  Canvas 逐格绘制 + Viewbox 等比自适应（窗口缩放即整图缩放），
  颜色由 BinColorPalette 按 BinCode/类别决定，左下角浮层为颜色图例。
-->
<UserControl x:Class="WaferMapStudio.Rendering.WaferMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Viewbox Stretch="Uniform" Margin="10">
            <Canvas x:Name="MapCanvas" />
        </Viewbox>

        <!-- 图例浮层（ShowLegend=false 时隐藏） -->
        <Border x:Name="LegendHost" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,16" Padding="10,8" CornerRadius="6"
                Background="#CC111A2B" BorderBrush="#243553" BorderThickness="1"
                MaxHeight="220" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LegendItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                           Fill="{Binding Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Margin="8,0,0,0"
                                           FontSize="11.5" Foreground="#E6EEFA"
                                           VerticalAlignment="Center" MaxWidth="220"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CountText}" Margin="8,0,0,0"
                                           FontSize="11" Foreground="#9AB0CC"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
