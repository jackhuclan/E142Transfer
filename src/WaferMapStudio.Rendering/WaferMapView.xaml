<!--
  可复用晶圆图渲染控件（不依赖任何 ViewModel）：
  Canvas 逐格绘制 + Viewbox 等比自适应（窗口缩放即整图缩放），
  颜色由 BinColorPalette 按 BinCode/类别决定，左下角浮层为颜色图例。

  缩放：滚轮在整图上缩放（上滚放大 / 下滚缩小），锚点为鼠标位置；
  缩放倍数与平移量由 Core 的 ViewportZoom 计算，这里只做 ScaleTransform/TranslateTransform 绑定。
  放大后可用中键或右键拖动平移（左键保留给 die 点选），滚回 1.0 即回到适应视口。
-->
<UserControl x:Class="WaferMapStudio.Rendering.WaferMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 外层裁剪：放大后的地图不得溢出到相邻卡片上 -->
    <Grid x:Name="RootLayer" Background="Transparent" ClipToBounds="True">
        <!-- 视口：内缩 10px 让地图不贴边；缩放/平移只作用于这个区域 -->
        <Grid x:Name="ViewportLayer" Margin="10" Background="Transparent" ClipToBounds="True">
            <Viewbox x:Name="MapViewbox" Stretch="Uniform">
                <Viewbox.RenderTransform>
                    <!-- 顺序即矩阵顺序：先缩放，再平移（屏幕坐标 = 内容坐标 × Scale + Offset） -->
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomScaleTransform" />
                        <TranslateTransform x:Name="ZoomPanTransform" />
                    </TransformGroup>
                </Viewbox.RenderTransform>
                <Canvas x:Name="MapCanvas" />
            </Viewbox>
        </Grid>

        <!-- 图例浮层（ShowLegend=false 时隐藏）：亮色半透明白底，叠在地图上仍可读 -->
        <Border x:Name="LegendHost" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,16" Padding="10,8" CornerRadius="6"
                Background="#E6FFFFFF" BorderBrush="#D8E0EA" BorderThickness="1"
                MaxHeight="220" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LegendItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                           Fill="{Binding Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Margin="8,0,0,0"
                                           FontSize="11.5" Foreground="#1F2937"
                                           VerticalAlignment="Center" MaxWidth="220"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CountText}" Margin="8,0,0,0"
                                           FontSize="11" Foreground="#64748B"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
