<Solution>
  <!--
    分层结构与磁盘一致（见 AGENTS.md §4）：
    Solution Items = 解决方案级文件；src = 源码；tests = 测试；tools = 工具。
    新增项目必须加入对应分组，分组名固定，不再新增一级分组。
  -->
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="README.md" />
    <File Path="AGENTS.md" />
  </Folder>

  <Folder Name="/src/">
    <Project Path="src/E142Transfer/E142Transfer.csproj" />
    <Project Path="src/WaferMapStudio.Core/WaferMapStudio.Core.csproj" />
    <Project Path="src/WaferMapStudio.Motion/WaferMapStudio.Motion.csproj" />
    <Project Path="src/WaferMapStudio.Io/WaferMapStudio.Io.csproj" />
    <Project Path="src/WaferMapStudio.Lighting/WaferMapStudio.Lighting.csproj" />
    <Project Path="src/WaferMapStudio.ViewModel/WaferMapStudio.ViewModel.csproj" />
    <Project Path="src/WaferMapStudio.Rendering/WaferMapStudio.Rendering.csproj" />
    <Project Path="src/WaferMapStudio.App/WaferMapStudio.App.csproj" />
  </Folder>

  <Folder Name="/tests/">
    <Project Path="tests/E142Transfer.SelfTest/E142Transfer.SelfTest.csproj" />
    <Project Path="tests/WaferMapStudio.Core.Tests/WaferMapStudio.Core.Tests.csproj" />
    <Project Path="tests/WaferMapStudio.Motion.Tests/WaferMapStudio.Motion.Tests.csproj" />
    <Project Path="tests/WaferMapStudio.Io.Tests/WaferMapStudio.Io.Tests.csproj" />
    <Project Path="tests/WaferMapStudio.Lighting.Tests/WaferMapStudio.Lighting.Tests.csproj" />
    <Project Path="tests/WaferMapStudio.ViewModel.Tests/WaferMapStudio.ViewModel.Tests.csproj" />
  </Folder>

  <Folder Name="/tools/">
    <Project Path="tools/E142Transfer.RealSampleCheck/RealSampleCheck.csproj" />
    <Project Path="tools/E142Transfer.MotionControlDemo/E142Transfer.MotionControlDemo.csproj" />
  </Folder>
</Solution>
